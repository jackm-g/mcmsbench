# Must match RCON_PASSWORD in infra/docker-compose.yml (its default is mcmsbench-rcon)
RCON_PASSWORD=mcmsbench-rcon
# For `mcmsbench compare --summarize` only
# ANTHROPIC_API_KEY=
# Where agent manifests are found (PROTOCOL.md §1): directories or .toml files, separated by ':' (';' on Windows),
# relative to this checkout
# MCMSBENCH_AGENT_PATH=../myagent/mcmsbench
